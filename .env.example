# Local: dejar VITE_API_BASE_URL vacío. Vite proxy /api → 127.0.0.1:3000
# Producción en Vercel: dejar vacío para usar el proxy /api de vercel.json a Render.
# Solo para conexión directa desde otro hosting: URL pública Nest sin barra final;
# en ese caso configurar también CORS_ORIGINS en Render.
VITE_API_BASE_URL=

# Supabase (publishable / anon). Nunca pongas la contraseña de la base aquí.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NASA_API_KEY se configura solo en ../NASA_SPACE_APP-BACKEND/.env; nunca VITE_.
